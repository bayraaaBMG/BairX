{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "ignore": ["node_modules", "scripts", ".git", "*.log"],
    "predeploy": ["node -e \"require('fs').copyFileSync('js/pricing.js','functions/pricing.js')\""]
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "storage.rules", ".git/**", "node_modules/**", "functions/**", "tests/**"]
  }
}
