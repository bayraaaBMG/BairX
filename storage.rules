rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Staff = owner (verified token email, same literal as firestore.rules ownerEmail()) or a
    // users/{uid} doc with role admin/manager — read cross-service from Firestore so there is
    // still exactly one place a role is granted.
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email == 'bbayraaa20@gmail.com' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['owner', 'admin', 'manager']
      );
    }
    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes && request.resource.contentType.matches('image/.*');
    }

    // Listing photos — path is scoped by the uploader's own uid, mirroring how
    // firestore.rules scopes every listing write to request.auth.uid == ownerId.
    // Public read: listing photos are shown to logged-out visitors on the public
    // site (same as `allow read: if true` on listings/{listingId} in Firestore),
    // but only the owner can ever write into their own folder, and only real
    // images under 12MB — matching the client-side size guard in my-listings.js.
    // Read also covers list(), which account deletion (js/legal.js) uses to find and
    // remove every photo in the user's own folder.
    match /listing-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isImageUnder(12 * 1024 * 1024);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Admin bulk upload (js/admin-media.js): complex photos and photos attached to an
    // existing listing by staff. Images are compressed client-side to ≤1600px before upload,
    // so 5MB is a generous ceiling.
    match /complex-images/{complexId}/{fileName} {
      allow read: if true;
      allow write: if isStaff() && isImageUnder(5 * 1024 * 1024);
      allow delete: if isStaff();
    }
    match /admin-listing-images/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isStaff() && isImageUnder(5 * 1024 * 1024);
      allow delete: if isStaff();
    }

    // Everything else stays closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
