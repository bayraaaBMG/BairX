rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Listing photos — path is scoped by the uploader's own uid, mirroring how
    // firestore.rules scopes every listing write to request.auth.uid == ownerId.
    // Public read: listing photos are shown to logged-out visitors on the public
    // site (same as `allow read: if true` on listings/{listingId} in Firestore),
    // but only the owner can ever write into their own folder, and only real
    // images under 12MB — matching the client-side size guard in my-listings.js.
    match /listing-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else stays closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
