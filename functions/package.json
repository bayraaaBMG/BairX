{
  "name": "bairx-functions",
  "private": true,
  "description": "BairX Cloud Functions: daily complexStats, hot list, alerts",
  "main": "index.js",
  "engines": { "node": "20" },
  "scripts": {
    "copy-shared": "node -e \"require('fs').copyFileSync('../js/pricing.js','pricing.js')\"",
    "migrate": "npm run copy-shared && node scripts/migrate-listings.js",
    "migrate:apply": "npm run copy-shared && node scripts/migrate-listings.js --apply",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  }
}
