{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/optout", "destination": "/index.html" },
    { "source": "/complexes", "destination": "/index.html" },
    { "source": "/complex/:id", "destination": "/index.html" },
    { "source": "/hotlist", "destination": "/index.html" },
    { "source": "/valuation", "destination": "/index.html" },
    { "source": "/budget", "destination": "/index.html" },
    { "source": "/growth", "destination": "/index.html" },
    { "source": "/alerts", "destination": "/index.html" },
    { "source": "/crm", "destination": "/index.html" },
    { "source": "/b/:slug", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
