rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // There are no Cloud Functions/custom claims in this app, so "admin" is just a `role`
    // field on the user's own profile doc — checked here via get(), never trusted from the
    // client's `currentUser` object. Promoting an account to admin can only be done by
    // editing that field directly in the Firebase Console (see the `users` rule below for
    // why a signed-in user can never grant this to themselves).
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // A blocked user can no longer create or edit listings — set by an admin (see the
    // users/{uid} rule below), never by the user themselves.
    function isBlocked() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == true;
    }

    // ===== USERS =====
    // Profile doc, keyed by uid. Only the account owner can read/write it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      // `role` may never change through a client write (create or update) — it can only be
      // 'user' at creation and can only change afterwards via the Firebase Console. Without
      // this, any signed-in user could set role:'admin' on their own doc and unlock the
      // admin dashboard / moderation actions below.
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      // Admin-only "block user" action — scoped to exactly the `blocked` field on ANY
      // user's doc, never role (still Console-only) and never anything else.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked']);
      allow delete: if false;
    }

    // ===== LISTINGS =====
    // Lifecycle: pending (just submitted/edited, awaiting review) -> active (admin-approved,
    // public) -> sold/rented (owner marks complete) or expired (30 days, auto) -> closed.
    // Admin can also reject (pending -> rejected) at any point during review. Only status ==
    // 'active' is ever returned by the public read query (loadPublicListings in data.js), so
    // this field is what actually gates visibility — not a separate "published" flag.
    match /listings/{listingId} {
      allow read: if true;

      // A brand-new listing can't already be admin-verified or start out publicly visible —
      // otherwise a malicious owner could just set listingVerified/status themselves. Blocked
      // users can't create listings at all.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.get('listingVerified', false) == false
                    && request.resource.data.get('status', 'pending') == 'pending'
                    && !isBlocked();

      // Owner can edit/delete their own listing, with guardrails: they can never flip
      // listingVerified into true (only the admin rule below can), never reset their own
      // reportCount (would let a scammer erase their reports), and can't move `status`
      // anywhere except the transitions that don't require a human review — any edit resets
      // to 'pending' (my-listings.js does this on every save), an expired listing can be
      // renewed straight back to 'active' (content didn't change), and an active listing can
      // be marked sold/rented/expired by its own owner. Only an admin can move something INTO
      // 'active' from 'pending'/'rejected', or move it INTO 'rejected' at all.
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
                    && !isBlocked()
                    && !(request.resource.data.get('listingVerified', false) == true
                         && resource.data.get('listingVerified', false) != true)
                    && request.resource.data.get('reportCount', 0) == resource.data.get('reportCount', 0)
                    && (
                         request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending') ||
                         request.resource.data.status == 'pending' ||
                         (resource.data.status == 'expired' && request.resource.data.status == 'active') ||
                         (resource.data.status == 'active' && request.resource.data.status in ['sold', 'rented', 'expired'])
                       );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Anyone (including logged-out viewers) may bump viewCount by exactly 1, nothing else.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                    && request.resource.data.viewCount == resource.data.viewCount + 1;

      // Any signed-in user may bump reportCount by exactly 1 (reporting someone else's listing).
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
                    && request.resource.data.reportCount == resource.data.reportCount + 1;

      // Admin moderation — approve/reject/archive from the admin dashboard, scoped to only
      // the fields it touches, never full content.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'listingVerified', 'rejectionReason']);

      // Admin can hard-delete any listing (spam/abuse) — owners can only delete their own,
      // via the rule above.
      allow delete: if isAdmin();
    }

    // ===== NEW DEVELOPMENTS (барилгын компанийн шинэ төслүүд) =====
    match /projects/{projectId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      // Owner can edit/delete their own project.
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Anyone (including logged-out viewers) may bump viewCount by exactly 1, nothing else.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                    && request.resource.data.viewCount == resource.data.viewCount + 1;

      // Any signed-in user may bump contactCount by exactly 1 (revealed the phone number).
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactCount'])
                    && request.resource.data.contactCount == resource.data.contactCount + 1;
    }

    // ===== FAVORITES =====
    match /favorites/{favId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      // Owner may update their own favorite doc (used to track priceAtSave for price-drop alerts).
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // ===== SAVED SEARCHES =====
    match /savedSearches/{searchId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ===== NOTIFICATIONS =====
    // Written client-side (no Cloud Functions): saved-search matches and price-drop alerts
    // are created by the current user's own browser after checking real listings, so create
    // is scoped to the owner just like reads. Delete is disallowed — "mark all read" only
    // ever flips `read`, never removes the doc.
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ===== REPORTS =====
    // Write-only from a regular client — reporting a listing never lets you read other
    // people's reports. The admin dashboard is the one reader/moderator (see isAdmin()).
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ===== TRANSACTIONS (boost purchase history — demo payment, real tracking) =====
    match /transactions/{txnId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ===== CHATS =====
    match /chats/{chatId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
