rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USERS =====
    // Profile doc, keyed by uid. Only the account owner can read/write it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ===== LISTINGS =====
    // Public marketplace: every visitor, logged in or not, must be able to read active
    // listings (loadPublicListings() runs on every page load, including logged-out).
    match /listings/{listingId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      // Owner can edit/delete their own listing.
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Anyone (including logged-out viewers) may bump viewCount by exactly 1, nothing else.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                    && request.resource.data.viewCount == resource.data.viewCount + 1;

      // Any signed-in user may bump reportCount by exactly 1 (reporting someone else's listing).
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
                    && request.resource.data.reportCount == resource.data.reportCount + 1;
    }

    // ===== FAVORITES =====
    match /favorites/{favId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      // Owner may update their own favorite doc (used to track priceAtSave for price-drop alerts).
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // ===== SAVED SEARCHES =====
    match /savedSearches/{searchId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ===== NOTIFICATIONS =====
    // Written client-side (no Cloud Functions): saved-search matches and price-drop alerts
    // are created by the current user's own browser after checking real listings, so create
    // is scoped to the owner just like reads. Delete is disallowed — "mark all read" only
    // ever flips `read`, never removes the doc.
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ===== REPORTS =====
    // Write-only from the client. Reading/moderating reports is an admin/Cloud-Functions job.
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ===== TRANSACTIONS (boost purchase history — demo payment, real tracking) =====
    match /transactions/{txnId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ===== CHATS =====
    match /chats/{chatId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
